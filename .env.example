# Frontend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_OFFLINE_IMAGE_PROXY_URL=https://your-worker-name.your-subdomain.workers.dev
VITE_SCRAPER_PROXY_URL=https://your-worker-name.your-subdomain.workers.dev
VITE_MEDIA_BUCKET_URL=https://your-r2-dev-domain.r2.dev

# Optional local media ingest worker
MEDIA_INGEST_URL=https://your-media-ingest-worker.your-subdomain.workers.dev
MEDIA_INGEST_TOKEN=your-media-ingest-token
MEDIA_BUCKET_URL=https://your-r2-dev-domain.r2.dev

# `media:backfill:chapters --apply` icin SERVICE ROLE key'i .env icine yazmayin.
# Gecici olarak sadece komut oturumunda verin.
# PowerShell:
# $env:SUPABASE_SERVICE_ROLE_KEY='your-supabase-service-role-key'; npm run media:backfill:chapters

# Supabase Edge Function secrets
# Bunlari frontend .env olarak yayinlama. Supabase project secrets tarafina gir.
PUBLIC_SITE_URL=https://your-site-domain.com
MAL_CLIENT_ID=your-myanimelist-client-id
MAL_CLIENT_SECRET=your-myanimelist-client-secret
ANILIST_CLIENT_ID=your-anilist-client-id
ANILIST_CLIENT_SECRET=your-anilist-client-secret

# Optional custom OAuth callback URLs
# Bos birakirsan kod otomatik olarak
# https://your-project-ref.supabase.co/functions/v1/external-sync?provider=...
# formatini kullanir.
MAL_REDIRECT_URL=https://your-project-ref.supabase.co/functions/v1/external-sync?provider=myanimelist
ANILIST_REDIRECT_URL=https://your-project-ref.supabase.co/functions/v1/external-sync?provider=anilist
