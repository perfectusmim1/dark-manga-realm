name = "toonparrot-offline-image-proxy"
main = "worker.js"
compatibility_date = "2026-03-26"
workers_dev = true

[vars]
ALLOWED_HOSTS = "hayalistic.net,hayalistic.com,webtoonhatti.club,webtoonhatti.me,webtoon-oku.net,yedek.mangawow.com,kirmizikafa.monster"
ALLOWED_ORIGINS = "https://toonparrot.vercel.app,http://localhost:8080,http://127.0.0.1:8080"
PUBLIC_BUCKET_URL = "https://your-r2-dev-domain.r2.dev"

# Set this with `wrangler secret put PROXY_TOKEN`
# PROXY_TOKEN = ""
